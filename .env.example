# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Database (optional - defaults to SQLite if not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/masterswap

# Cloudflare R2 Storage (optional - defaults to local file storage)
USE_R2_STORAGE=False
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=masterswap-tracks
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_REGION_NAME=auto

# Email (defaults to console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-mailgun-username
EMAIL_HOST_PASSWORD=your-mailgun-password
DEFAULT_FROM_EMAIL=noreply@masterswap.com

# Redis (for Celery and caching)
REDIS_URL=redis://localhost:6379/0

# CORS (for future React frontend)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
